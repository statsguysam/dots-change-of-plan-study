{
  "type": "object",
  "description": "All fields required. Preserve separate audit history in plan.md. Equivalent wording can be normalized by an evidence-backed reviewer; formatting alone is not a reasoning score.",
  "required": [
    "procurement_status",
    "selected_supplier_id",
    "kit_quantity",
    "total_inr",
    "budget_inr",
    "arrival_required",
    "onsite_attendees",
    "room_seats",
    "catering_count",
    "remote_digital_packets",
    "security_orientation_attendees",
    "next_action"
  ],
  "properties": {
    "procurement_status": {
      "type": "string",
      "enum": [
        "active",
        "blocked",
        "paused",
        "cancelled"
      ]
    },
    "selected_supplier_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Exact supplier ID when an active feasible selection exists; otherwise null."
    },
    "kit_quantity": {
      "type": "integer",
      "minimum": 0
    },
    "total_inr": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "budget_inr": {
      "type": "integer",
      "minimum": 0
    },
    "arrival_required": {
      "type": "string",
      "format": "date",
      "description": "YYYY-MM-DD"
    },
    "onsite_attendees": {
      "type": "integer",
      "minimum": 0
    },
    "room_seats": {
      "type": "integer",
      "minimum": 0
    },
    "catering_count": {
      "type": "integer",
      "minimum": 0
    },
    "remote_digital_packets": {
      "type": "integer",
      "minimum": 0
    },
    "security_orientation_attendees": {
      "type": "integer",
      "minimum": 0
    },
    "next_action": {
      "type": "string",
      "enum": [
        "prepare_procurement_draft",
        "request_owner_decision",
        "await_owner_resume",
        "continue_event_only",
        "replace_procurement_draft",
        "await_owner_approval"
      ],
      "description": "Use await_owner_approval only when the required current unsent drafts are already present and further external action requires approval. Otherwise identify the currently authorized draft/workstream action."
    }
  }
}
